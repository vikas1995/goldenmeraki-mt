# GoldenMeraki Backend Environment Variables Example
# Application
NODE_ENV=production
PORT=3000
ENABLE_SWAGGER=false

# Allowed Origins (Comma-separated list or exact origins)
CORS_ORIGIN=https://goldenmeraki.vercel.app,https://golden-meraki-app.vercel.app,http://localhost:5173

# Database Connection
MONGODB_URI=mongodb+srv://goldenmerakigems_db_user:<db_password>@goldenmeraki.8jsjfld.mongodb.net/

# JWT Security Credentials
JWT_SECRET=super_secret_jwt_key_replace_in_production_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_replace_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Credentials (Seeded on first startup)
ADMIN_EMAIL=admin@goldenmeraki.com
ADMIN_PASSWORD=SecureAdminPassword123!

# Cloudinary Storage Credentials (If enabled)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Services / SMTP (If enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@goldenmeraki.com
SMTP_PASS=your_app_password

# WhatsApp Messaging Integration (If enabled)
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
